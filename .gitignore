# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
node_modules/
package-lock.json
package.json

# ==========================================
# Caches and temporary files
# ==========================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Virtual environments
# ==========================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Lecture slides & internal docs (keep local)
# ==========================================
slides/*.pptx
slides/*.pdf
!slides/.gitkeep
docs/*
!docs/.gitkeep

# ==========================================
# Large Datasets & Reproducible Artifacts (Do NOT commit to Git!)
# ==========================================
data/raw/*.csv
data/raw/*.zip
data/processed/*.csv
data/processed/*.csv.gz
data/processed/*.parquet
data/processed/*.pkl
data/processed/*.npz
data/processed/*.joblib
data/processed/*.json
models/*.joblib
models/*.pkl
reports/*.csv
reports/*.json
reports/*.md
reports/figures/*.png

# Keep directory structure & small reproducibility indices
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/train_indices_*.npy
!models/.gitkeep
!reports/.gitkeep
!reports/figures/.gitkeep

# ==========================================
# OS & IDE files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ==========================================
# Microsoft Office lock files
# ==========================================
~$*
